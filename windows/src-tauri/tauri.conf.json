{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokei",
  "version": "1.0.48",
  "identifier": "com.tokei.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Tokei",
        "url": "index.html",
        "width": 900,
        "height": 780,
        "minWidth": 420,
        "minHeight": 420,
        "center": true,
        "preventOverflow": true,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "theme": "Dark",
        "backgroundColor": "#1f2128",
        "shadow": true,
        "focus": true
      },
      {
        "label": "quick",
        "create": false,
        "title": "Tokei Quick",
        "url": "index.html?surface=quick",
        "width": 520,
        "height": 680,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "theme": "Dark",
        "backgroundColor": "#1f2128",
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../native_bridge.py": "collector/windows_native.py",
      "../../usage.30s.py": "collector/usage.30s.py",
      "../../pricing.json": "collector/pricing.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
